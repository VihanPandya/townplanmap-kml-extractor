# TownPlanMap KML Extractor — configuration
#
# Copy to .env.local and adjust. Every value is optional; the defaults are the
# conservative ones.

# --- Source ----------------------------------------------------------------

# The upstream the tool points at. Change only to target a self-hosted mirror.
# TPM_BASE_URL=https://townplanmap.com

# The User-Agent sent upstream. The default identifies the tool honestly; it
# deliberately does not impersonate a browser.
# TPM_USER_AGENT=TownPlanMap-KML-Extractor/1.0 (+https://github.com/vihanpandya/townplanmap-kml-extractor)

# --- Storage ---------------------------------------------------------------

# A PostgreSQL database with PostGIS available. Without this the catalog is
# held in memory and is lost when the server restarts.
# Apply the schema once with: npm run db:init
# DATABASE_URL=postgres://user:password@localhost:5432/townplanmap

# Where large generated exports are spilled to disk.
# TPM_EXPORT_DIR=./storage/exports

# --- Crawl and export limits ------------------------------------------------
#
# Each of these is clamped to a hard ceiling in src/lib/config.ts that the
# environment cannot raise. They are shown on the Settings screen.

# TPM_MAX_REQUESTS_PER_SCAN=150
# TPM_MAX_RESPONSE_BYTES=25165824
# TPM_REQUEST_TIMEOUT_MS=20000
# TPM_MAX_CONCURRENT_REQUESTS=4
# TPM_MAX_REDIRECTS=3
# TPM_MAX_FEATURES_PER_LAYER=50000
# TPM_MAX_FEATURES_PER_EXPORT=100000
# TPM_MAX_KML_BYTES=268435456
# TPM_MAX_VERTICES_PER_GEOMETRY=2000000
# TPM_MAX_XML_BYTES=33554432
# TPM_FEATURE_PAGE_SIZE=1000
# TPM_PER_HOST_THROTTLE_MS=120

# How wide the scan casts its net. A code-split application can keep its map
# configuration in a chunk well down the list, so reading more bundles finds
# more; each one costs a request.
# TPM_MAX_SCRIPTS_READ=16
# TPM_MAX_PROBES=40
# TPM_MAX_CONFIG_DOCUMENTS=10
# TPM_MAX_DIAGNOSTIC_ENTRIES=300

# --- Browser-assisted discovery ---------------------------------------------
#
# A plain scan reads the page and its scripts as text, so it cannot see a URL
# the application assembles while it runs — which is how most map front-ends
# work. The deep scan opens the source in a browser already installed on this
# machine and records the requests the site makes for itself. It is opt-in per
# scan from the dashboard; these change the defaults.
#
# It runs the site's own code. It carries no credentials or stored session, it
# clicks through nothing, it disguises nothing, and every request it makes is
# checked against the same address rules as the server-side fetcher.

# Switch the deep scan on for every scan.
# TPM_BROWSER_SCAN=1

# An explicit path to Chrome, Chromium or Edge. Without this, the usual install
# locations for the platform are checked in turn.
# TPM_BROWSER_PATH=/usr/bin/chromium
# TPM_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# TPM_BROWSER_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Show the browser window rather than running it hidden.
# TPM_BROWSER_HEADED=1

# How long to keep listening after the page loads. Raise it for a slow site or
# one that fetches its layers well after first paint.
# TPM_BROWSER_SETTLE_MS=9000
# TPM_BROWSER_TIMEOUT_MS=45000
# TPM_BROWSER_MAX_REQUESTS=500

# --- Basemaps ---------------------------------------------------------------
#
# The map's basemaps are third-party raster tile services. The defaults are
# public services whose attribution the map displays. For anything beyond light
# use, point these at your own tile server or a provider you have an agreement
# with, and set the matching attribution string.

# NEXT_PUBLIC_BASEMAP_MAP_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_BASEMAP_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
# NEXT_PUBLIC_BASEMAP_SATELLITE_URL=
# NEXT_PUBLIC_BASEMAP_SATELLITE_ATTRIBUTION=
# NEXT_PUBLIC_BASEMAP_TERRAIN_URL=
# NEXT_PUBLIC_BASEMAP_TERRAIN_ATTRIBUTION=

# --- Development ------------------------------------------------------------

# Adds a synthetic sample dataset so the tool can be exercised without network
# access to the source. The data is invented and is labelled as synthetic
# everywhere, including inside exported KML. Never enable this in production.
# TPM_ENABLE_FIXTURE_SOURCE=1
